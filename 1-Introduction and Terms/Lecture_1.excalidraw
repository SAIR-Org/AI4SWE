    {
      "id": "wVdlEM2ev0ZrSQ7EreAt5",
      "type": "text",
      "x": -1803.6239541402622,
      "y": 3085.3021102178677,
      "width": 1118.4659194418452,
      "height": 250.7603963216151,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5X",
      "roundness": null,
      "seed": 1083301480,
      "version": 652,
      "versionNonce": 1766344296,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776821311952,
      "link": null,
      "locked": false,
      "text": "After AlexNet, deep learning explodes in two parallel\nuniverses. Computer Vision and NLP have different\narchitectures, different conferences, different\ncommunities. A researcher in one barely reads papers\nfrom the other.",
      "fontSize": 40.121663411458414,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After AlexNet, deep learning explodes in two parallel universes. Computer Vision and NLP have different architectures, different conferences, different communities. A researcher in one barely reads papers from the other.",
      "autoResize": false,
      "lineHeight": 1.25
    },
