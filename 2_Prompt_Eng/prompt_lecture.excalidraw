    {
      "id": "uRDXeqz-httwBl9ucGjyt",
      "type": "text",
      "x": 24527.40781495616,
      "y": 31914.823942761977,
      "width": 764.6403198242188,
      "height": 315,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c09A",
      "roundness": null,
      "seed": 2036395759,
      "version": 239,
      "versionNonce": 1464210465,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1778172732636,
      "link": null,
      "locked": false,
      "text": "A common pattern is hidden or private CoT.\nThe model is prompted to reason step-by-\nstep internally, but only the final answer is\nsurfaced to the user. This preserves the\naccuracy benefits of CoT while avoiding\nverbosity, UX clutter, and potential leakage\nof sensitive intermediate reasoning.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A common pattern is hidden or private CoT. The model is prompted to reason step-by-step internally, but only the final answer is surfaced to the user. This preserves the accuracy benefits of CoT while avoiding verbosity, UX clutter, and potential leakage of sensitive intermediate reasoning.",
      "autoResize": false,
      "lineHeight": 1.25
    }
  ],
