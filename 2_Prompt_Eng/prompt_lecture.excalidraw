      "isDeleted": false,
      "boundElements": null,
      "updated": 1778167186176,
      "link": null,
      "locked": false,
      "text": "prompting is a first-class component of the\napplication. We treat prompts like code: we\ndesign them methodically, test them, version-\ncontrol them, and continuously improve them.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "prompting is a first-class component of the application. We treat prompts like code: we design them methodically, test them, version-control them, and continuously improve them.",
      "autoResize": false,
      "lineHeight": 1.25
    },
