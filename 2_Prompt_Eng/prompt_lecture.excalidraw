      "link": null,
      "locked": false,
      "text": "# 2 Chain of Though (CoT) Prompting",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 2 Chain of Though (CoT) Prompting",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jQUQ6we-MONDPrsHGPK_4",
      "type": "text",
      "x": 24476.159859633895,
      "y": 29956.97012959059,
      "width": 2496.384521484375,
      "height": 180,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c08z",
      "roundness": null,
      "seed": 417848449,
      "version": 338,
      "versionNonce": 50616303,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1778172662522,
      "link": null,
      "locked": false,
      "text": "From an implementation standpoint, CoT prompting typically takes one of two forms:\n\n1- Zero-shot CoT, where the developer adds a generic reasoning cue such as “Let’s think step by step.”\n2- Few-shot CoT, where the prompt includes one or more worked examples that explicitly show intermediate reasoning before the final answer.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "From an implementation standpoint, CoT prompting typically takes one of two forms:\n\n1- Zero-shot CoT, where the developer adds a generic reasoning cue such as “Let’s think step by step.”\n2- Few-shot CoT, where the prompt includes one or more worked examples that explicitly show intermediate reasoning before the final answer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
